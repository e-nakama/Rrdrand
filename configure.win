@echo off
REM configure.win - Windows configuration script for Rrdrand
REM Detects processor architecture (ARM or x86/x86_64)

setlocal enabledelayedexpansion

REM Get processor architecture from environment variable
set ARCH=%PROCESSOR_ARCHITECTURE%

echo Detecting processor architecture...
echo Processor Architecture: %ARCH%

REM Determine if x86 or ARM
if /i "%ARCH%"=="x86" (
    echo x86 (32-bit) detected
    set HAVE_X86_CPUID=1
) else if /i "%ARCH%"=="AMD64" (
    echo x86_64 (64-bit) detected
    set HAVE_X86_CPUID=1
) else if /i "%ARCH%"=="ARM" (
    echo ARM (32-bit) detected
    set HAVE_X86_CPUID=0
) else if /i "%ARCH%"=="ARM64" (
    echo ARM64 (64-bit) detected
    set HAVE_X86_CPUID=0
) else (
    echo Unknown architecture: %ARCH%
    echo Defaulting to x86 support
    set HAVE_X86_CPUID=1
)

REM Create or update config.h with architecture-specific settings
echo Creating config.h...

REM Check if config.h.in exists
if not exist "src\config.h.in" (
    echo Error: src\config.h.in not found
    exit /b 1
)

REM Generate config.h from config.h.in
if exist "src\config.h" (
    del "src\config.h"
)

(
    echo /* config.h - Generated by configure.win */
    echo #ifndef CONFIG_H
    echo #define CONFIG_H
    echo.
    if %HAVE_X86_CPUID% equ 1 (
        echo #define HAVE_X86_CPUID 1
    ) else (
        echo #define HAVE_X86_CPUID 0
    )
    echo.
    echo #endif /* CONFIG_H */
) > "src\config.h"

echo Configuration complete!
echo HAVE_X86_CPUID=%HAVE_X86_CPUID%

endlocal
